[Unit]
Description=ATLAS inventory scan
After=atlas-helper.service
Wants=atlas-helper.service

[Service]
Type=oneshot
User=atlas
Group=atlas
# Same sandbox as the panel: a home directory is borrowed through the helper.
SupplementaryGroups=systemd-journal
ExecStart=/opt/atlas/.venv/bin/atlas scan --root / --db /var/lib/atlas/atlas.db --helper-socket /run/atlas/helper.sock
TimeoutStartSec=900
StateDirectory=atlas
StateDirectoryMode=0700
UMask=0117
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/atlas /run/atlas
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=50%
