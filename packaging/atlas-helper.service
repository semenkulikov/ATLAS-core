[Unit]
Description=ATLAS root helper
After=network.target systemd-tmpfiles-setup.service

[Service]
Type=simple
User=root
ExecStartPre=-/bin/rm -f /run/atlas/helper.sock
ExecStart=/opt/atlas/.venv/bin/python -m atlas.helper --socket /run/atlas/helper.sock --uid __UID__
NoNewPrivileges=yes
PrivateNetwork=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/run/atlas
MemoryMax=64M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
